<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33B39DFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/app_glass_top"
                android:endColor="@color/app_glass_bottom" />
            <stroke android:width="1dp" android:color="@color/app_glass_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
