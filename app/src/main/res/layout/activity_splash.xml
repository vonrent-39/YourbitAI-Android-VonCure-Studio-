<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.youraicqa.app.SplashOrbView
            android:id="@+id/splashOrb"
            android:layout_width="240dp"
            android:layout_height="240dp" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yourbit AI"
            android:textColor="@color/app_text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Загрузка..."
            android:textColor="@color/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="26dp" />

        <TextView
            android:id="@+id/statusSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запуск"
            android:textColor="@color/app_text_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/progressPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/app_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/btnOffline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Продолжить без сети"
            android:textColor="@color/app_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_marginTop="18dp"
            android:visibility="invisible" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yourbit AI v3.0.0 · by VonCure Studio"
            android:textColor="@color/app_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
